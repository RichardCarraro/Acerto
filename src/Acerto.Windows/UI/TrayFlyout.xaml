<Window x:Class="Acerto.Windows.UI.TrayFlyout" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acertô" Width="300" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True">
    <!-- Menu da bandeja: painel translúcido (acrílico) como os menus do Windows 11 -->
    <Border Padding="8">
        <StackPanel>
            <Grid Margin="8,6,8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusDot" Width="36" Height="36" CornerRadius="18" Background="#1E63D6">
                    <TextBlock Text="ô" Foreground="White" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="Acertô" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StatusHint" Style="{StaticResource RowHint}" />
                </StackPanel>
                <CheckBox x:Name="ActiveSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="ActiveSwitch_Click" />
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,0,4,6" />

            <Button Style="{StaticResource MenuRow}" Tag="home" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                    <TextBlock Text="Configurações" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Tag="shortcuts" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" />
                    <TextBlock Text="Atalhos de texto" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Tag="words" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE82D;" />
                    <TextBlock Text="Minhas palavras" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Tag="support" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEB51;" />
                    <TextBlock Text="Apoie o projeto" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="4,6" />

            <Button Style="{StaticResource MenuRow}" Click="Exit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                    <TextBlock Text="Sair" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
