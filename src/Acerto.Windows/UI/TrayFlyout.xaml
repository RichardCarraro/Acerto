<Window x:Class="Acerto.Windows.UI.TrayFlyout" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acertô" Width="232" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True">
    <!-- Menu da bandeja: compacto e translúcido (acrílico), como os menus de contexto do Windows 11 -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MenuRow}">
            <Setter Property="Height" Value="30" />
        </Style>
        <Style x:Key="MenuGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="MenuText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Padding="4">
        <StackPanel>
            <Grid Margin="10,6,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusDot" Width="24" Height="24" CornerRadius="12" Background="#1E63D6">
                    <TextBlock Text="ô" Foreground="White" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" Text="Acertô" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StatusHint" Style="{StaticResource RowHint}" />
                </StackPanel>
                <CheckBox x:Name="ActiveSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="ActiveSwitch_Click" />
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,4" />

            <Button Tag="home" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE713;" />
                    <TextBlock Style="{StaticResource MenuText}" Text="Configurações" />
                </StackPanel>
            </Button>
            <Button Tag="shortcuts" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE765;" />
                    <TextBlock Style="{StaticResource MenuText}" Text="Atalhos de texto" />
                </StackPanel>
            </Button>
            <Button Tag="words" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE82D;" />
                    <TextBlock Style="{StaticResource MenuText}" Text="Minhas palavras" />
                </StackPanel>
            </Button>
            <Button Tag="support" Click="Open_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEB51;" />
                    <TextBlock Style="{StaticResource MenuText}" Text="Apoie o projeto" />
                </StackPanel>
            </Button>

            <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

            <Button Click="Exit_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7E8;" />
                    <TextBlock Style="{StaticResource MenuText}" Text="Sair" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
