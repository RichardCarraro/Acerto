<Window x:Class="Acerto.Windows.UI.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acertô" Width="880" Height="740" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <DockPanel Grid.Column="0" Margin="8,12,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,18">
                <Border Width="32" Height="32" CornerRadius="16" Background="#1E63D6">
                    <TextBlock Text="ô" Foreground="White" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Acertô" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="NavStatus" Text="Carregando…" Style="{StaticResource RowHint}" />
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Style="{StaticResource RowHint}" Margin="12,0,0,0" />

            <StackPanel>
                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" />
                        <TextBlock Text="Início" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavShortcuts" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" />
                        <TextBlock Text="Atalhos de texto" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavWords" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE82D;" />
                        <TextBlock Text="Minhas palavras" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" />
                        <TextBlock Text="Apps excluídos" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSupport" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEB51;" />
                        <TextBlock Text="Apoie o projeto" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- Páginas -->
        <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="8"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <!-- Início -->
                <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Início" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="O Acertô corrige o que você digita em qualquer programa, na hora, como o teclado do celular." />

                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="StatusDot" Width="44" Height="44" CornerRadius="22" Background="#1E63D6">
                                    <TextBlock Text="ô" Foreground="White" FontSize="26" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" Text="Carregando o dicionário…" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="StatusHint" Text="Só um instante." Style="{StaticResource RowHint}" />
                                </StackPanel>
                                <CheckBox x:Name="ActiveSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="ActiveSwitch_Click" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CountText" Text="0" Style="{StaticResource TitleLargeTextBlockStyle}"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="palavras corrigidas" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Só o número é guardado. O que você digita nunca sai do computador."
                                               Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Comportamento" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,18,0,8" />

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="CapSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Option_Click" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8D2;" Margin="0,0,16,0" />
                                <StackPanel>
                                    <TextBlock Text="Maiúscula automática" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Começa cada frase com letra maiúscula." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="PeriodSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Option_Click" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE70F;" Margin="0,0,16,0" />
                                <StackPanel>
                                    <TextBlock Text="Dois espaços viram ponto" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Aperte espaço duas vezes para terminar a frase com ponto final." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="AnimationSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Option_Click" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE945;" Margin="0,0,16,0" />
                                <StackPanel>
                                    <TextBlock Text="Destacar a palavra corrigida" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Mostra um realce rápido sobre a palavra, como no celular." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="Startup_Click" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7E8;" Margin="0,0,16,0" />
                                <StackPanel>
                                    <TextBlock Text="Iniciar com o Windows" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Abre o Acertô sozinho quando você liga o computador." Style="{StaticResource RowHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource RowHint}" Margin="2,14,0,0"
                                   Text="Dica: Ctrl+Shift+F12 pausa e retoma o Acertô de qualquer lugar." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Atalhos -->
                <ScrollViewer x:Name="PageShortcuts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Atalhos de texto" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="Digite o atalho e aperte espaço: ele vira o texto completo. Exemplo: vlw vira valeu." />
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Atalho" Style="{StaticResource RowHint}" Margin="0,0,0,4" />
                                    <TextBox x:Name="ShortcutTrigger" KeyDown="ShortcutBox_KeyDown" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="&#xE72A;" Margin="12,20,12,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Vira o texto" Style="{StaticResource RowHint}" Margin="0,0,0,4" />
                                    <TextBox x:Name="ShortcutText" KeyDown="ShortcutBox_KeyDown" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Adicionar" Style="{StaticResource AccentButtonStyle}"
                                        Margin="12,20,0,0" Click="AddShortcut_Click" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ShortcutError" Foreground="#C42B1C" Visibility="Collapsed" Margin="2,4,0,4" />
                        <ItemsControl x:Name="ShortcutList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Tag="{Binding Key}" Click="RemoveShortcut_Click" ToolTip="Remover"
                                                    Padding="8,6">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                                            </Button>
                                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="110" />
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" FontSize="12" Margin="8,0,14,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Minhas palavras -->
                <ScrollViewer x:Name="PageWords" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Minhas palavras" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="Palavras que o Acertô nunca corrige: nomes, siglas, gírias. Ele também aprende sozinho quando você apaga uma correção e digita a palavra de novo." />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Adicionar" Style="{StaticResource AccentButtonStyle}"
                                        Margin="12,0,0,0" Click="AddWord_Click" />
                                <TextBox x:Name="WordBox" KeyDown="WordBox_KeyDown" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="WordsEmpty" Style="{StaticResource RowHint}" Margin="2,12,0,0"
                                   Text="Nenhuma palavra ainda." />
                        <ItemsControl x:Name="WordList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveWord_Click" ToolTip="Remover" Padding="8,6">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Apps excluídos -->
                <ScrollViewer x:Name="PageApps" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Apps excluídos" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="Programas onde o Acertô não corrige. Editores de código e terminais já vêm na lista. Use o nome do processo, como Code.exe." />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Adicionar" Style="{StaticResource AccentButtonStyle}"
                                        Margin="12,0,0,0" Click="AddApp_Click" />
                                <TextBox x:Name="AppBox" KeyDown="AppBox_KeyDown" />
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="AppList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Tag="{Binding}" Click="RemoveApp_Click" ToolTip="Remover" Padding="8,6">
                                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Apoie -->
                <ScrollViewer x:Name="PageSupport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,22,28,22">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Apoie o projeto" Style="{StaticResource PageTitle}" />
                        <TextBlock Style="{StaticResource PageHint}"
                                   Text="O Acertô é grátis e completo, e sempre vai ser. Se ele te ajuda no dia a dia, considere apoiar com um Pix de qualquer valor." />
                        <Border Style="{StaticResource Card}" Padding="24">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="180" Height="180" CornerRadius="8" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="QR Code em breve" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="Chave Pix: em breve" HorizontalAlignment="Center" Margin="0,14,0,0"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SupportCount" Style="{StaticResource RowHint}" Margin="2,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
