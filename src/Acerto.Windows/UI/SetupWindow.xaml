<Window x:Class="Acerto.Windows.UI.SetupWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar o Acertô" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="48" Height="48" CornerRadius="24" Background="#1E63D6">
                <TextBlock Text="ô" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Acertô" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="VersionText" Style="{StaticResource RowHint}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="Intro" Style="{StaticResource PageHint}"
                   Text="Corretor automático em português que funciona em qualquer programa: você digita “nao”, aperta espaço e já virou “não”." />

        <StackPanel x:Name="OptionsPanel">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="True"
                              AutomationProperties.Name="Iniciar junto com o Windows" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Iniciar junto com o Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="O ô fica perto do relógio, corrigindo." Style="{StaticResource RowHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <CheckBox x:Name="DesktopSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                              AutomationProperties.Name="Atalho na área de trabalho" />
                    <TextBlock Text="Atalho na área de trabalho" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <TextBlock x:Name="ProgressText" Text="Instalando…" Style="{StaticResource RowTitle}" Margin="0,0,0,8" />
            <ProgressBar x:Name="Progress" Height="4" Maximum="1" />
        </StackPanel>

        <StackPanel x:Name="DonePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="#0F7B0F" FontSize="20" />
            <TextBlock x:Name="DoneText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Margin="10,0,0,0"
                       VerticalAlignment="Center" Text="Pronto! O ô já está perto do relógio." />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="#C42B1C" TextWrapping="Wrap" Margin="0,12,0,0"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" MinWidth="96" Click="Cancel_Click" />
            <Button x:Name="InstallButton" Content="Instalar" MinWidth="120" Margin="8,0,0,0" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" Click="Install_Click" />
        </StackPanel>
    </StackPanel>
</Window>
